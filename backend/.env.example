# ==================== 应用配置 ====================
DEBUG=True
ENVIRONMENT=development
TIMEZONE=Asia/Shanghai
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256

# ==================== 数据库配置 ====================
DATABASE_URL=postgresql://qiping_user:qiping_password@localhost:5432/qiping_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=False

# ==================== Redis 配置 ====================
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_EXPIRE=3600
REDIS_RATE_LIMIT_EXPIRE=60

# ==================== Celery 配置 ====================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TIMEZONE=Asia/Shanghai

# ==================== OpenAI 配置 ====================
OPENAI_API_KEY=sk-xxxxx
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# ==================== Anthropic Claude 配置 ====================
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL=claude-3-opus-20240229

# ==================== Midjourney 配置 ====================
MIDJOURNEY_API_KEY=xxxxx
MIDJOURNEY_CHANNEL_ID=xxxxx

# ==================== Stability AI 配置 ====================
STABILITY_AI_API_KEY=sk-xxxxx
STABILITY_AI_ENGINE_ID=stable-diffusion-xl-1024-v1-0

# ==================== Google Cloud 配置 ====================
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_CREDENTIALS=./credentials.json
GOOGLE_TEXT_TO_SPEECH_LANGUAGE=zh-CN

# ==================== AWS S3 配置 ====================
AWS_ACCESS_KEY_ID=xxxxx
AWS_SECRET_ACCESS_KEY=xxxxx
AWS_S3_BUCKET=qiping-content
AWS_S3_REGION=us-east-1

# ==================== CORS 配置 ====================
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# ==================== JWT 配置 ====================
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=30

# ==================== 邮件配置 ====================
MAIL_FROM=noreply@qiping.ai
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_NAME=QiPing
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# ==================== 文件上传配置 ====================
MAX_UPLOAD_SIZE=52428800  # 50MB
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,mp4,mp3,webp
UPLOAD_DIR=./uploads

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# ==================== 第三方服务 ====================
GITHUB_CLIENT_ID=xxxxx
GITHUB_CLIENT_SECRET=xxxxx
GOOGLE_CLIENT_ID=xxxxx
GOOGLE_CLIENT_SECRET=xxxxx

# ==================== 监控和分析 ====================
SENTRY_DSN=
MIXPANEL_TOKEN=
GOOGLE_ANALYTICS_ID=
